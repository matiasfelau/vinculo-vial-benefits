# Entorno: "development" (por defecto) o "production". Con production la configuración
# rechaza los valores inseguros de desarrollo: DATABASE_URL con sslmode=disable, RABBITMQ_URL
# con las credenciales guest y claves de los códigos de un solo byte repetido.
APP_ENV=development

# Puerto HTTP público del servicio (Kong lo alcanza acá). Por defecto 8080.
PORT=8080

# Puerto del router de administración (carga de campañas, de lotes de códigos y de reportes
# de canje). Se sirve en un *http.Server separado del público, nunca lo publica Kong, y el
# docker-compose de desarrollo lo expone solo en 127.0.0.1:8084. Debe ser distinto de PORT.
# Por defecto 8082.
HTTP_ADMIN_PORT=8082

# Clave del router de administración: toda ruta /admin/* la exige en el header
# X-Admin-Api-Key (se compara a tiempo constante). Mínimo 32 caracteres; generala con
# `openssl rand -base64 48`. Si queda vacía, el router de administración NO arranca y el
# servicio loguea un aviso.
ADMIN_API_KEY=

# Cadena de conexión a la base PostgreSQL propia del servicio (database-per-service). Con
# APP_ENV=production no admite sslmode=disable. Obligatoria.
DATABASE_URL=postgres://benefits:benefits@localhost:5432/benefits?sslmode=disable

# Plazo máximo, en milisegundos, de cada consulta de los endpoints públicos y del consumidor
# contra la base propia. Agotado, el servicio responde 503 DEPENDENCY_UNAVAILABLE en lugar
# de esperar. Por defecto 1500.
DB_QUERY_TIMEOUT_MS=1500

# Plazo máximo, en milisegundos, de cada operación del router de administración. Es mayor
# porque cargar un lote de hasta 100.000 códigos lleva más que una consulta. Por defecto 30000.
ADMIN_DB_TIMEOUT_MS=30000

# URL del broker RabbitMQ compartido por el ecosistema. La topología (exchange, cola
# benefits.user-deleted.q con su .retry y su .dlq) la declara vinculo-vial-core: este
# servicio solo consume y publica a la DLQ. Si el broker está caído, el servicio arranca igual
# y el consumidor reconecta con backoff. Con APP_ENV=production no admite las credenciales
# guest. Obligatoria.
RABBITMQ_URL=amqp://guest:guest@vinculo-vial-rabbitmq:5672/

# Plazo, en milisegundos, de cada publicación a la DLQ, incluida la espera del publisher
# confirm. Por defecto 2000.
RABBITMQ_PUBLISH_TIMEOUT_MS=2000

# Cola de trabajo de la que se consume user.deleted (baja de cuenta): pasa a BURNED los
# códigos del usuario. Sigue la convención <consumidor>.<evento-kebab>.q y debe coincidir con
# la que declara vinculo-vial-core. Por defecto benefits.user-deleted.q.
USER_DELETED_QUEUE=benefits.user-deleted.q

# Prefetch (basic.qos) del consumidor: cuántos mensajes sin ack admite el canal en vuelo.
# Entre 1 y 65535. Por defecto 10.
RABBITMQ_PREFETCH=10

# Reintentos de un mensaje con fallo transitorio (cola .retry con TTL, contados por x-death)
# antes de derivarlo a la DLQ. Mayor o igual a 0. Por defecto 5.
MAX_RETRIES=5

# Clave AES-256 (32 bytes en base64) con la que se cifra cada código en reposo, para poder
# devolvérselo al usuario. Generala con `openssl rand -base64 32`. Obligatoria. Rotarla
# deja ilegibles los códigos ya cargados.
BENEFITS_CODE_AES_KEY=

# Clave HMAC-SHA256 (32 bytes en base64) con la que se calcula el HMAC de cada código: sirve
# para deduplicar la carga y emparejar los canjes sin descifrar. Generala con
# `openssl rand -base64 32`. Obligatoria e independiente de BENEFITS_CODE_AES_KEY: con el
# mismo valor, o con algo que no decodifique a 32 bytes, el servicio no arranca. Rotarla
# rompe el emparejamiento de los códigos ya cargados.
BENEFITS_CODE_HMAC_KEY=

# Tamaño máximo, en bytes, del banner de una campaña (PNG, JPEG o WebP). Entre 1 y 10485760.
# Por defecto 307200 (300 KiB).
BANNER_MAX_BYTES=307200
